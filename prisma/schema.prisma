// Ember & Oak Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Table {
  id           String        @id @default(cuid())
  tableNumber  Int           @unique
  name         String
  area         String        // HEARTH_COUNTER, MAIN_DINING, WINE_VAULT, TERRACE
  capacityMin  Int           @default(1)
  capacityMax  Int           @default(4)
  isActive     Boolean       @default(true)
  reservations Reservation[]

  createdAt    DateTime      @default(now())
}

model Reservation {
  id              String   @id @default(cuid())
  reference       String   @unique
  guestName       String
  guestEmail      String
  guestPhone      String
  partySize       Int
  date            String   // YYYY-MM-DD
  timeSlot        String   // HH:MM e.g. "18:00"
  seatingArea     String   @default("MAIN_DINING") // HEARTH_COUNTER, MAIN_DINING, WINE_VAULT, TERRACE, ANY
  occasion        String?  // Anniversary, Birthday, Date Night, Business, Celebration
  dietaryNotes    String?
  specialRequests String?
  status          String   @default("CONFIRMED") // CONFIRMED, SEATED, CANCELLED, COMPLETED
  
  tableId         String?
  table           Table?   @relation(fields: [tableId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Strict double-booking prevention at the database level for active tables
  @@index([date, timeSlot])
  @@index([guestEmail])
  @@index([reference])
}

model MenuItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   // STARTERS, MAINS, WOOD_FIRED, DESSERTS, COCKTAILS_WINE
  price       Float
  description String
  dietaryTags String   // e.g. "GF,DF,CHEF_FAVORITE"
  pairing     String?  // Sommelier pairing recommendation
  image       String
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}
